# Put credentials in ./secrets/ (see deploy/README.md). This file holds only
# Compose interpolation values and non-secret application settings.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# LLM_MAX_RETRIES=3
# LLM_TIMEOUT_SECONDS=60

# SEC EDGAR fair access requires a real name and address on every request.
# Requests without one are rate-limited and IP-blocked. Also used for
# filings.xbrl.org, which is free and best-effort in the same way.
SEC_CONTACT_NAME="Your Name"
SEC_CONTACT_EMAIL=you@example.com
# INGEST_MAX_CONSECUTIVE_FAILURES=20
# Minimum source/publisher credibility after recency decay. Lower-scored
# articles are audited as filtered without invoking fact extraction.
# INGEST_PRE_SCORE_MIN=0.30
# INGEST_MAX_NEWS_PER_FEED=30

# Production PostgreSQL. Use the shared server's alias on the external Docker
# network. The optional managed-database override provides the same
# `postgres-shared` alias, so the DSNs do not change between deployment modes.
# 127.0.0.1 would point back at the application container.
# The password is supplied to libpq separately, so it need not be URL-encoded
# into the DSN. Leave MARKETMIND_DATABASE_DSN unset in local dev/tests to use
# the disposable docker-compose.yml database on 127.0.0.1:5433.
MARKETMIND_DATABASE_DSN=postgresql://marketmind@postgres-shared:5432/marketmind
# Existing external Docker network also joined by the shared PostgreSQL
# service. Create a dedicated network with this name for managed mode.
MARKETMIND_DATABASE_NETWORK=postgres-network
# Used only by docker-compose.managed-db.yml, which can become the shared
# instance for later projects on the same host.
POSTGRES_DATA_VOLUME=postgres-shared-data
# Copy both digest references from the matching release bundle's release.env.
# The application and optional dashboard run from the same exact image.
MARKETMIND_IMAGE=
MARKETMIND_POSTGRES_IMAGE=

# The MCP token is in secrets/mcp_token; this port defaults to 8000.
# MARKETMIND_MCP_PORT=8000
# Mutable lock/status/log directory shared by the server and scheduled jobs.
# MARKETMIND_REFRESH_DIR=/var/lib/marketmind/refresh

# Optional read-only operations dashboard (the `dashboard` Compose profile).
# It reads agent_runs and job logs only, through a SELECT-only database role
# created separately -- see deploy/README.md. Its token and database password
# are in secrets/dashboard_token and secrets/dashboard_pgpass. Published on
# 127.0.0.1 only: reach it with an SSH port-forward, or put a
# TLS-terminating reverse proxy in front of it.
MARKETMIND_DASHBOARD_DSN=postgresql://marketmind_ro@postgres-shared:5432/marketmind
# MARKETMIND_DASHBOARD_PORT=8001

# Numeric owner of the host data directory. Set these from `id -u`
# and `id -g` on the production host so the non-root container can write the
# bind-mounted data tree without making the service run as root.
MARKETMIND_UID=
MARKETMIND_GID=
