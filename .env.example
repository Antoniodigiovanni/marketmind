AI_API_KEY=sk-...
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# LLM_MAX_RETRIES=3
# LLM_TIMEOUT_SECONDS=60
FRED_API_KEY=...

# SEC EDGAR fair access requires a real name and address on every request.
# Requests without one are rate-limited and IP-blocked. Also used for
# filings.xbrl.org, which is free and best-effort in the same way.
SEC_CONTACT_NAME="Your Name"
SEC_CONTACT_EMAIL=you@example.com
# INGEST_MAX_CONSECUTIVE_FAILURES=20

# Production Postgres (docker-compose.prod.yml). MARKETMIND_DB_PASSWORD sets
# the container's password on first start; MARKETMIND_DATABASE_DSN is what
# the app connects with -- the password in both must match. Leave both unset
# for local dev/tests: pool.py falls back to the disposable docker-compose.yml
# test database on 127.0.0.1:5433.
MARKETMIND_DB_PASSWORD=change-me
MARKETMIND_DATABASE_DSN=postgresql://marketmind:change-me@127.0.0.1:5432/marketmind

# Shared secret the harness must present as a bearer token
# (Authorization: Bearer <token>) on every MCP request. The port the MCP
# server listens on (and docker-compose.prod.yml publishes) -- both default
# to 8000 if MARKETMIND_MCP_PORT is left unset.
MARKETMIND_MCP_TOKEN=change-me
# MARKETMIND_MCP_PORT=8000
