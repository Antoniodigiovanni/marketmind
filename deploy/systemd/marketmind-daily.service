[Unit]
Description=marketmind daily price/macro fetch + news ingest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=marketmind
Group=marketmind
WorkingDirectory=/srv/marketmind
EnvironmentFile=/srv/marketmind/.env
Environment=HOME=/srv/marketmind
Environment=UV_CACHE_DIR=/srv/marketmind/.cache
# --frozen --no-sync: ProtectSystem=strict leaves .venv read-only, so uv must
# never try to re-lock or re-sync the environment at run time.
ExecStart=/usr/local/bin/uv run --frozen --no-sync python data/fetch.py
ExecStart=/bin/sh -c '/usr/local/bin/uv run --frozen --no-sync python -m agent.ingestion "$(date -I)"'
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
ReadWritePaths=/srv/marketmind/data /srv/marketmind/.cache
