[Unit]
Description=marketmind weekly universe refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=marketmind
Group=marketmind
WorkingDirectory=/srv/marketmind
EnvironmentFile=/srv/marketmind/.env
Environment=HOME=/srv/marketmind
Environment=UV_CACHE_DIR=/srv/marketmind/.cache
ExecStart=/usr/local/bin/uv run python -m data.universe.update
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
ReadWritePaths=/srv/marketmind/data /srv/marketmind/.cache
