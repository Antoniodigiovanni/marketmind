[Unit]
Description=marketmind weekly self-update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
# Runs the root-owned copy under /usr/local/sbin, never the one inside the
# install tree: that tree is writable by the marketmind service user, which
# processes untrusted network input. install.sh/update.sh keep the copy fresh.
ExecStart=/usr/local/sbin/marketmind-update
UMask=0022
